architecture-beta
  group edge(cloud)[Public]
  group cloud(cloud)[Azure]
  group data(database)[Data] in cloud

  service shop(internet)[Web shop] in edge
  service gateway(server)[Gateway] in cloud
  service api(server)[Orders API] in cloud
  service erp(server)[ERP] in cloud
  service orders(database)[Orders] in data
  service invoices(disk)[Invoices] in data
  junction split in cloud

  shop{group}:R --> L:gateway{group}
  gateway:R --> L:api
  api:R -- L:split
  split:R --> L:orders
  split:B --> T:invoices
  api:B <-[posts and reads]-> T:erp
